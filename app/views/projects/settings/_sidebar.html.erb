<% content_for :header_tags do %>
  <%= javascript_include_tag('toggle_functions_jquery', plugin: 'gimel_sidebar') %>
<% end %>

<%= form_for(:sidebar,
             url: { controller: 'sidebar', action: 'edit', id: @project },
             html: { id: 'sidebar-content-form', class: 'tabular' },
             remote: true) do %>

  <%= render partial: 'sidebar/form', locals: { sidebar: @sidebar, project: @project } %>

<% visible = (params[:sidebar] && params[:sidebar][:content_type].present?) || (@sidebar && @sidebar.content_type.present?) %>

<span id="preview-link" style="<%= 'display: none;' unless visible %>">
  <%= submit_tag l(:label_preview),
                 name: 'preview',
                 formaction: preview_sidebar_path(@project),
                 formmethod: :post,
                 remote: true,
                class: 'link-as-button'%>
</span>


<% end %>

<div id="preview" class="wiki"></div>

